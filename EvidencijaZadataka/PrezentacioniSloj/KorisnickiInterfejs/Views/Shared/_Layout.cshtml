<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Evidencija zadataka</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Zadatak" asp-action="Spisak">
                Evidencija zadataka
            </a>
            <div class="collapse navbar-collapse">
                @if (Context.Session.GetString("KorisnickoIme") != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Zadatak" asp-action="Spisak">
                                Zadaci
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Zadatak" asp-action="Unos">
                                Novi zadatak
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Zadatak" asp-action="StampajSpisak">
                                Štampaj spisak
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                @Context.Session.GetString("KorisnickoIme")
                            </span>
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <form asp-controller="Nalog" asp-action="Odjava"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-outline-light">
                                    Odjava
                                </button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Poruka"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Greska"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Greska"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/validacije.js"></script>
    @await RenderSectionAsync("Skripte", required: false)
</body>
</html>
