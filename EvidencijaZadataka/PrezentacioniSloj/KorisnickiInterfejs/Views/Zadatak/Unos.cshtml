@using PrezentacioniSloj.PrezentacionaLogika.ViewModels
@model ZadatakViewModel
@{
    ViewData["Title"] = "Novi zadatak";
}

<h2>Novi zadatak</h2>

<form asp-action="Unos" method="post" id="formaZadatak">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

    @* MASTER — podaci o zadatku *@
    <div class="card mb-3">
        <div class="card-header bg-dark text-white">
            <strong>Podaci o zadatku</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-8">
                    <label asp-for="Naziv" class="form-label"></label>
                    <input asp-for="Naziv" class="form-control" id="naziv"
                           placeholder="Naziv zadatka..." />
                    <span asp-validation-for="Naziv" class="text-danger small"></span>
                    <div id="greska-naziv" class="text-danger small"></div>
                </div>

                <div class="col-md-4">
                    <label asp-for="TipZadatka" class="form-label"></label>
                    <select asp-for="TipZadatka" class="form-select">
                        <option value="">— Izaberite tip —</option>
                        <option value="Funkcija">Funkcija</option>
                        <option value="Bag">Bag</option>
                        <option value="Umetnost">Umetnost</option>
                    </select>
                    <span asp-validation-for="TipZadatka" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Opis" class="form-label"></label>
                    <textarea asp-for="Opis" class="form-control" rows="3"
                              placeholder="Opis zadatka (opciono)..."></textarea>
                </div>

                <div class="col-md-6">
                    <label asp-for="KljucnaTackaRazvojaID" class="form-label"></label>
                    <select asp-for="KljucnaTackaRazvojaID" class="form-select">
                        <option value="">— Izaberite ključnu tačku —</option>
                        @foreach (var k in Model.KljucneTacke)
                        {
                            <option value="@k.ID">@k.Naziv</option>
                        }
                    </select>
                    <span asp-validation-for="KljucnaTackaRazvojaID"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ClanTimaID" class="form-label"></label>
                    <select asp-for="ClanTimaID" class="form-select">
                        <option value="">— Izaberite člana —</option>
                        @foreach (var c in Model.Clanovi)
                        {
                            <option value="@c.ID">@c.Naziv</option>
                        }
                    </select>
                    <span asp-validation-for="ClanTimaID" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="RokZaZavrsetak" class="form-label"></label>
                    <input asp-for="RokZaZavrsetak" type="date" class="form-control"
                           id="rokZaZavrsetak"
                           value="@Model.RokZaZavrsetak.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="RokZaZavrsetak"
                          class="text-danger small"></span>
                    <div id="greska-rok" class="text-danger small"></div>
                </div>

                <div class="col-md-4">
                    <label asp-for="Prioritet" class="form-label"></label>
                    <select asp-for="Prioritet" class="form-select">
                        <option value="Nizak">Nizak</option>
                        <option value="Srednji" selected>Srednji</option>
                        <option value="Visok">Visok</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Otvoren" selected>Otvoren</option>
                        <option value="U radu">U radu</option>
                        <option value="Testiranje">Testiranje</option>
                        <option value="Zavrseno">Zavrseno</option>
                        <option value="Kasni">Kasni</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="ProcenatZavrsenosti" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ProcenatZavrsenosti" type="number"
                               class="form-control" id="procenat"
                               min="0" max="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="ProcenatZavrsenosti"
                          class="text-danger small"></span>
                    <div id="greska-procenat" class="text-danger small"></div>
                </div>

                <div class="col-md-8">
                    <label asp-for="Napomena" class="form-label"></label>
                    <input asp-for="Napomena" class="form-control"
                           placeholder="Napomena (opciono)..." />
                </div>

            </div>
        </div>
    </div>

    @* DETAIL — podzadaci *@
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white
            d-flex justify-content-between align-items-center">
            <strong>Podzadaci</strong>
            <button type="button" class="btn btn-sm btn-light"
                    id="dugmeDodajStavku">
                ➕ Dodaj podzadatak
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px" class="text-center">Rb.</th>
                        <th>Naziv podzadatka</th>
                        <th style="width:100px" class="text-center">Zavrseno</th>
                        <th style="width:60px"></th>
                    </tr>
                </thead>
                <tbody id="telStavki">
                    @for (int i = 0; i < Model.Stavke.Count; i++)
                    {
                        <tr class="red-stavke">
                            <td class="text-center align-middle rb-col">
                                @(i + 1).
                            </td>
                            <td>
                                <input type="hidden"
                                       name="Stavke[@i].StavkaID"
                                       value="@Model.Stavke[i].StavkaID" />
                                <input type="text"
                                       name="Stavke[@i].NazivPodzadatka"
                                       value="@Model.Stavke[i].NazivPodzadatka"
                                       class="form-control form-control-sm naziv-stavke"
                                       placeholder="Naziv podzadatka..." />
                            </td>
                            <td class="text-center align-middle">
                                <input type="checkbox"
                                       name="Stavke[@i].Zavrseno"
                                       value="true"
                                       class="form-check-input"
                                @(Model.Stavke[i].Zavrseno ? "checked" : "") />
                                <input type="hidden"
                                       name="Stavke[@i].Zavrseno"
                                       value="false" />
                            </td>
                            <td class="text-center align-middle">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger dugme-ukloni">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            Podzadaci su opcioni. Maksimalno 50 podzadataka.
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-dark"
                onclick="return validirajFormu()">
            Sačuvaj zadatak
        </button>
        <a asp-action="Spisak" class="btn btn-outline-secondary">Otkaži</a>
    </div>

</form>

@section Skripte {
    <script>
        let brojRedova = @Model.Stavke.Count;

        document.getElementById("dugmeDodajStavku")
            .addEventListener("click", function() {
                const telo = document.getElementById("telStavki");
                const ukupno = telo.querySelectorAll(".red-stavke").length;

                if (ukupno >= 50) {
                    alert("Maksimalno 50 podzadataka.");
                    return;
                }

                const red = document.createElement("tr");
                red.classList.add("red-stavke");
                red.innerHTML = `
                    <td class="text-center align-middle rb-col">${ukupno + 1}.</td>
                    <td>
                        <input type="hidden"
                               name="Stavke[${brojRedova}].StavkaID" value="0" />
                        <input type="text"
                               name="Stavke[${brojRedova}].NazivPodzadatka"
                               class="form-control form-control-sm naziv-stavke"
                               placeholder="Naziv podzadatka..." />
                    </td>
                    <td class="text-center align-middle">
                        <input type="checkbox"
                               name="Stavke[${brojRedova}].Zavrseno"
                               value="true" class="form-check-input" />
                        <input type="hidden"
                               name="Stavke[${brojRedova}].Zavrseno" value="false" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger dugme-ukloni">
                            ✕
                        </button>
                    </td>`;

                telo.appendChild(red);
                brojRedova++;
                osvezi();
                red.querySelector(".naziv-stavke").focus();
            });

        document.getElementById("telStavki")
            .addEventListener("click", function(e) {
                if (e.target.classList.contains("dugme-ukloni")) {
                    e.target.closest("tr").remove();
                    osvezi();
                }
            });

        function osvezi() {
            document.querySelectorAll(".red-stavke").forEach((r, i) => {
                r.querySelector(".rb-col").textContent = (i + 1) + ".";
            });
        }

        function validirajFormu() {
            return true;
        }
    </script>
}