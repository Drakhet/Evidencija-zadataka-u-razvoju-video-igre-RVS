@using SlojPodataka.KlasePodataka
@model Zadatak
@{
    ViewData["Title"] = "Brisanje zadatka";
}

<h2>Brisanje zadatka</h2>

<div class="alert alert-warning">
    <strong>Da li ste sigurni da želite da obrišete ovaj zadatak?</strong><br />
    Brisanjem zadatka brišu se i svi njegovi podzadaci (@Model.Stavke.Count).
    Ova akcija je trajna.
</div>

<dl class="row">
    <dt class="col-sm-3">Šifra</dt>
    <dd class="col-sm-9"><code>@Model.Sifra</code></dd>

    <dt class="col-sm-3">Naziv</dt>
    <dd class="col-sm-9">@Model.Naziv</dd>

    <dt class="col-sm-3">Ključna tačka</dt>
    <dd class="col-sm-9">@Model.KljucnaTackaRazvoja?.Naziv</dd>

    <dt class="col-sm-3">Zaduženi član</dt>
    <dd class="col-sm-9">@Model.ClanTima?.PunoIme</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Broj podzadataka</dt>
    <dd class="col-sm-9">@Model.Stavke.Count</dd>
</dl>

<form asp-action="Obrisi" asp-route-id="@Model.ZadatakID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Da, obriši</button>
    <a asp-action="Spisak" class="btn btn-outline-secondary">Otkaži</a>
</form>