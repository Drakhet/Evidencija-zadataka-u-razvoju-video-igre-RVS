@using SlojPodataka.KlasePodataka
@model Zadatak
@{
    ViewData["Title"] = $"Štampa — {Model.Sifra}";
    Layout = null;
    int dani = ViewBag.DaniDoRoka ?? 0;
}
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <title>Kartica zadatka — @Model.Sifra</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 11pt; color: #000; padding: 20px; }
        .kartica {
            border: 1px solid #000;
            padding: 20px;
            max-width: 600px;
            margin: 0 auto;
        }
        .separator { border-top: 1px dashed #000; margin: 10px 0; }
        .naslov-kartice { font-weight: bold; font-size: 13pt; margin-bottom: 4px; }
        .red { margin-bottom: 8px; }
        .vrednost {
            border-bottom: 1px solid #000;
            display: inline-block;
            min-width: 200px;
            padding-bottom: 1px;
        }
        .sekcija-naslov { font-weight: bold; margin-bottom: 8px; }
        .checkbox-red { margin-bottom: 4px; }
        .dugme-stampa { margin-bottom: 16px; }
        @@media print {
            .dugme-stampa { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>

    <div class="dugme-stampa">
        <button onclick="window.print()"
                style="padding:8px 20px;cursor:pointer;">
                Odštampaj
        </button>
        <button onclick="window.history.back()"
                style="padding:8px 20px;cursor:pointer;margin-left:8px;">
            ← Nazad
        </button>
    </div>

    <div class="kartica">
        <div class="separator"></div>
        <div class="naslov-kartice">KARTICA ZADATKA</div>
        <div class="separator"></div>

        <div class="red">
            Šifra zadatka:
            <span class="vrednost">@Model.Sifra</span>
        </div>
        <div class="red">
            Naziv zadatka:
            <span class="vrednost" style="min-width:300px">@Model.Naziv</span>
        </div>
        <div class="red">
            Tip zadatka: &nbsp;
            [ @(Model.TipZadatka == "Funkcija" ? "X" : " ") ] Funkcija &nbsp;&nbsp;
            [ @(Model.TipZadatka == "Bag"      ? "X" : " ") ] Bag &nbsp;&nbsp;
            [ @(Model.TipZadatka == "Umetnost" ? "X" : " ") ] Umetnost
        </div>
        <div class="red">
            Opis zadatka:
            <span class="vrednost" style="min-width:300px">
                @(string.IsNullOrEmpty(Model.Opis) ? "" : Model.Opis)
            </span>
        </div>

        <div class="separator"></div>
        <div class="sekcija-naslov">1. KLJUČNA TAČKA RAZVOJA</div>

        <div class="red">
            Ključna tačka:
            <span class="vrednost" style="min-width:250px">
                @Model.KljucnaTackaRazvoja?.Naziv
            </span>
        </div>
        <div class="red">
            Rok ključne tačke:
            <span class="vrednost">
                @Model.KljucnaTackaRazvoja?.DatumZavrsetka.ToString("dd.MM.yyyy")
            </span>
        </div>

        <div class="separator"></div>
        <div class="sekcija-naslov">2. DODELA I ROKOVI</div>

        <div class="red">
            Zadužena osoba:
            <span class="vrednost" style="min-width:220px">
                @Model.ClanTima?.PunoIme
            </span>
        </div>
        <div class="red">
            Datum kreiranja:
            <span class="vrednost">@Model.DatumKreiranja.ToString("dd.MM.yyyy")</span>
        </div>
        <div class="red">
            Rok za završetak:
            <span class="vrednost">@Model.RokZaZavrsetak.ToString("dd.MM.yyyy")</span>
        </div>
        <div class="red">
            Prioritet: &nbsp;
            [ @(Model.Prioritet == "Nizak"   ? "X" : " ") ] Nizak &nbsp;&nbsp;
            [ @(Model.Prioritet == "Srednji" ? "X" : " ") ] Srednji &nbsp;&nbsp;
            [ @(Model.Prioritet == "Visok"   ? "X" : " ") ] Visok
        </div>

        <div class="separator"></div>
        <div class="sekcija-naslov">3. PRAĆENJE REALIZACIJE</div>

        <div class="red">Status:</div>
        <div class="checkbox-red">[ @(Model.Status == "Otvoren"    ? "X" : " ") ] Otvoren</div>
        <div class="checkbox-red">[ @(Model.Status == "U radu"     ? "X" : " ") ] U radu</div>
        <div class="checkbox-red">[ @(Model.Status == "Testiranje" ? "X" : " ") ] Testiranje</div>
        <div class="checkbox-red">[ @(Model.Status == "Zavrseno"   ? "X" : " ") ] Zavrseno</div>
        <div class="checkbox-red" style="margin-bottom:8px">
            [ @(Model.Status == "Kasni" ? "X" : " ") ] Kasni
        </div>

        <div class="red">
            Procenat Zavrsenosti:
            <span class="vrednost" style="min-width:60px">
                @Model.ProcenatZavrsenosti
            </span> %
        </div>
        <div class="red">
            Napomena:
            <span class="vrednost" style="min-width:280px">
                @Model.Napomena
            </span>
        </div>

        <div class="separator"></div>
        <div class="red">
            Odgovorna osoba:
            <span class="vrednost" style="min-width:220px"></span>
        </div>
        <div class="red" style="margin-top:12px">
            Potpis:
            <span class="vrednost" style="min-width:220px"></span>
        </div>
        <div class="separator"></div>

    </div>

</body>
</html>