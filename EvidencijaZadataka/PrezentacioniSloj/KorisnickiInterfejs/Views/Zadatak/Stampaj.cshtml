@using SlojPodataka.KlasePodataka
@model Zadatak
@{
    ViewData["Title"] = $"Štampa — {Model.Sifra}";
    Layout = null;
    int dani = ViewBag.DaniDoRoka ?? 0;
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <title>Kartica zadatka — @Model.Sifra</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 11pt; color: #000; padding: 20px; }
        .zaglavlje { border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 16px; }
        .naslov { font-size: 16pt; font-weight: bold; text-transform: uppercase; }
        .meta { font-size: 9pt; color: #555; margin-top: 4px; }
        .sekcija { margin-bottom: 14px; }
        .sekcija-naslov {
            font-size: 10pt; font-weight: bold; text-transform: uppercase;
            border-bottom: 1px solid #ccc; padding-bottom: 3px;
            margin-bottom: 8px; color: #333;
        }
        .red { display: flex; margin-bottom: 4px; }
        .labela { width: 180px; font-weight: bold; flex-shrink: 0; color: #444; }
        .vrednost { flex: 1; }
        table { width: 100%; border-collapse: collapse; font-size: 10pt; }
        th { background: #eee; border: 1px solid #ccc; padding: 5px 8px; text-align: left; }
        td { border: 1px solid #ccc; padding: 5px 8px; }
        .podnozje {
            border-top: 1px solid #ccc; padding-top: 8px; margin-top: 20px;
            font-size: 9pt; color: #666;
            display: flex; justify-content: space-between;
        }
        .potpis {
            margin-top: 40px; border-top: 1px solid #000;
            width: 200px; padding-top: 4px; font-size: 9pt;
        }
        .dugme-stampa { margin-bottom: 16px; }
        @@media print {
            .dugme-stampa { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>

    <div class="dugme-stampa">
        <button onclick="window.print()"
                style="padding:8px 20px;cursor:pointer;">
            🖨 Odštampaj
        </button>
        <button onclick="window.history.back()"
                style="padding:8px 20px;cursor:pointer;margin-left:8px;">
            ← Nazad
        </button>
    </div>

    <div class="zaglavlje">
        <div class="naslov">Kartica zadatka</div>
        <div class="meta">
            Evidencija zadataka na razvoju igre &nbsp;|&nbsp;
            Šifra: <strong>@Model.Sifra</strong> &nbsp;|&nbsp;
            Odštampano: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>

    <div class="sekcija">
        <div class="sekcija-naslov">1. Podaci o zadatku</div>
        <div class="red">
            <span class="labela">Naziv zadatka:</span>
            <span class="vrednost">@Model.Naziv</span>
        </div>
        <div class="red">
            <span class="labela">Tip zadatka:</span>
            <span class="vrednost">@Model.TipZadatka</span>
        </div>
        <div class="red">
            <span class="labela">Opis:</span>
            <span class="vrednost">
                @(string.IsNullOrEmpty(Model.Opis) ? "—" : Model.Opis)
            </span>
        </div>
    </div>

    <div class="sekcija">
        <div class="sekcija-naslov">2. Razvojna etapa i dodela</div>
        <div class="red">
            <span class="labela">Ključna tačka:</span>
            <span class="vrednost">@Model.KljucnaTackaRazvoja?.Naziv</span>
        </div>
        <div class="red">
            <span class="labela">Zaduženi član tima:</span>
            <span class="vrednost">@Model.ClanTima?.PunoIme</span>
        </div>
        <div class="red">
            <span class="labela">Datum kreiranja:</span>
            <span class="vrednost">
                @Model.DatumKreiranja.ToString("dd.MM.yyyy")
            </span>
        </div>
        <div class="red">
            <span class="labela">Rok za završetak:</span>
            <span class="vrednost">
                @Model.RokZaZavrsetak.ToString("dd.MM.yyyy")
                @if (dani < 0)
                {
                    <span> — ROK ISTEKAO</span>
                }
                else if (dani <= 3)
                {
                    <span> — ističe za @dani dana</span>
                }
            </span>
        </div>
    </div>

    <div class="sekcija">
        <div class="sekcija-naslov">3. Praćenje realizacije</div>
        <div class="red">
            <span class="labela">Prioritet:</span>
            <span class="vrednost">@Model.Prioritet</span>
        </div>
        <div class="red">
            <span class="labela">Status:</span>
            <span class="vrednost">@Model.Status</span>
        </div>
        <div class="red">
            <span class="labela">Procenat završenosti:</span>
            <span class="vrednost">@Model.ProcenatZavrsenosti %</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Napomena))
        {
            <div class="red">
                <span class="labela">Napomena:</span>
                <span class="vrednost">@Model.Napomena</span>
            </div>
        }
    </div>

    @if (Model.Stavke.Any())
    {
        <div class="sekcija">
            <div class="sekcija-naslov">4. Podzadaci (@Model.Stavke.Count)</div>
            <table>
                <thead>
                    <tr>
                        <th style="width:50px">Rb.</th>
                        <th>Naziv podzadatka</th>
                        <th style="width:80px">Završeno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Stavke.OrderBy(x => x.RedniBroj))
                    {
                        <tr>
                            <td>@s.RedniBroj.</td>
                            <td>@s.NazivPodzadatka</td>
                            <td>@(s.Zavrseno ? "Da" : "Ne")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div style="display:flex;justify-content:space-between;margin-top:40px;">
        <div class="potpis">Odgovorna osoba</div>
        <div class="potpis">Potpis</div>
    </div>

    <div class="podnozje">
        <span>Evidencija zadataka na razvoju igre</span>
        <span>@Model.Sifra</span>
        <span>@DateTime.Now.ToString("dd.MM.yyyy")</span>
    </div>

</body>
</html>