@model PrezentacioniSloj.PrezentacionaLogika.ViewModels.PrijavaViewModel
@{
    ViewData["Title"] = "Prijava";
    Layout = null;
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prijava — Evidencija zadataka</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white text-center py-3">
                        <h4 class="mb-0">Evidencija zadataka</h4>
                        <small>Razvoj video igre</small>
                    </div>
                    <div class="card-body p-4">

                        @if (TempData["Poruka"] != null)
                        {
                            <div class="alert alert-success">@TempData["Poruka"]</div>
                        }

                        <form asp-action="Prijava" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="KorisnickoIme" class="form-label"></label>
                                <input asp-for="KorisnickoIme" class="form-control"
                                       autocomplete="username" />
                                <span asp-validation-for="KorisnickoIme"
                                      class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Lozinka" class="form-label"></label>
                                <input asp-for="Lozinka" type="password"
                                       class="form-control"
                                       autocomplete="current-password" />
                                <span asp-validation-for="Lozinka"
                                      class="text-danger small"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-dark">
                                    Prijavi se
                                </button>
                            </div>
                        </form>

                    </div>
                    <div class="card-footer text-center">
                        <small>
                            Nemate nalog?
                            <a asp-action="Registracija">Registrujte se</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>